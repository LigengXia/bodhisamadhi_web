# ───────────────────────────────────────────────────────────
# Bodhisamadhi Center — local development (.env.local)
# Copy to .env.local (gitignored). Production values live in Vercel.
# Key names match Docs/3-Tech-Stack-and-Version-Lock.md §12.
#
# LOCAL DEV RUNS AGAINST LOCAL SUPABASE. After `supabase start`, fill the
# three Supabase values from `supabase status` (they are the same on every
# machine — Supabase's published local dev keys).
#
# Hosted-project credentials (project ref, DB password, access token, the
# hosted API keys) go in .env.hosted — NOT here. The Supabase CLI auto-loads
# .env.local, so a hosted ref/password here would make local `db reset` /
# `test` / `gen types` hit the hosted database. See .env.hosted.example.
# ───────────────────────────────────────────────────────────

# ── Supabase — LOCAL (from `supabase status`) ──────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — bypasses every RLS policy.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2 (PDF + audio) ────────────────────────────
# SERVER ONLY. Private bucket; files reached via signed URLs (Docs/5 §14).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bodhisamadhi
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# ── Site ───────────────────────────────────────────────────
# Local dev: leave as localhost. In Vercel (Production + Preview) set this to
# the launch origin: https://bodhisamadhi-web.vercel.app  (a real domain later).
# Without it, every canonical / Open Graph / sitemap URL points at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave unset until launch — the whole site is noindex + robots Disallow
# until this is "true" (Docs/6 Phase 11 §5).
# SITE_INDEXABLE=true

# ── Observability (Docs/6 Phase 11 §4) ─────────────────────
# All optional. With no DSN, Sentry's init() is a no-op and the build skips
# its wrapper entirely. The three SENTRY_* below are only needed to upload
# source maps (readable stack traces); set them in Vercel, not here.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# Vercel Web Analytics + Speed Insights need no env — enable them in the
# Vercel project's Analytics tab.

# ── Deferred until later phases ────────────────────────────
# Phase 13 — Google OAuth (configured in the Supabase dashboard)
# Phase 17 — STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
#            NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY,
#            NEXT_PUBLIC_PAYPAL_CLIENT_ID, PAYPAL_CLIENT_SECRET
# Phase 18 — RESEND_API_KEY
