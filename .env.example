# ───────────────────────────────────────────────────────────
# Bodhisamadhi Center — local development, the Next.js app
# Copy to .env.local (gitignored) and fill in.
# Production values live in Vercel → Project → Environment Variables.
# Key names match Docs/3-Tech-Stack-and-Version-Lock.md §12.
#
# Hosted-Supabase CLI credentials (project ref, DB password) do NOT go
# here — the Supabase CLI auto-loads .env.local and would use them for
# LOCAL commands. They live in .env.hosted — see .env.hosted.example.
# ───────────────────────────────────────────────────────────

# ── Supabase ───────────────────────────────────────────────
# Safe to expose to the browser (RLS is the boundary):
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — bypasses every RLS policy. Never import into a
# client component, never log it, never send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2 (PDF + audio) ────────────────────────────
# SERVER ONLY. The bucket is private; files are reached through
# short-lived signed URLs issued by /api/media/[id]/url — see Docs/5 §14.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bodhisamadhi
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# ── Site ───────────────────────────────────────────────────
# Local dev. In Vercel this is the deployment URL.
NEXT_PUBLIC_SITE_URL=

# ── Deferred until later phases ────────────────────────────
# Phase 13 — Google OAuth (configured in the Supabase dashboard)
# Phase 17 — STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
#            NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY,
#            NEXT_PUBLIC_PAYPAL_CLIENT_ID, PAYPAL_CLIENT_SECRET
# Phase 18 — RESEND_API_KEY
# Phase 11 — SENTRY_DSN
