# ───────────────────────────────────────────────────────────
# HOSTED Supabase project — Supabase CLI use only.
# Copy to .env.hosted (gitignored via .env.*). Never read by the app.
#
# The Supabase CLI auto-loads .env.local, so these MUST NOT live there —
# a local `supabase db reset` / `db test` / `gen types --local` would pick
# up the hosted project ref and DB password and run against the wrong
# database. .env.hosted is NOT auto-loaded; it is passed explicitly:
#
#   npm run db:push     (dotenv -e .env.hosted -- supabase db push …)
#   npm run db:pull
# ───────────────────────────────────────────────────────────

SUPABASE_PROJECT_ID=<project-ref>
SUPABASE_DB_PASSWORD=<database-password>

# Full pooler connection string, region-specific. From the Supabase
# dashboard → Project Settings → Database → Connection string (Transaction
# pooler). Used as `supabase db push --db-url "$SUPABASE_DB_URL"`.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
